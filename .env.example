# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Site URL
NEXT_PUBLIC_SITE_URL="https://stepshome.org"

# Admin Panel
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_SECRET="at-least-16-chars-random-secret-key"

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Brevo (Sendinblue) Newsletter Integration
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
BREVO_LIST_ID="2"
# Optional Double Opt-In settings
BREVO_DOUBLE_OPT_IN_TEMPLATE_ID=""
BREVO_CONFIRMATION_REDIRECT_URL=""

# Cloudflare R2 Storage Integration
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="stepshome"
R2_PUBLIC_DOMAIN="https://pub-xxxxxxxx.r2.dev" # or custom domain like https://media.stepshome.org


